{
  // ── 格式化 ──────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "always"
  },

  // ── 语言专属格式化（只保留与顶层不同的）──────────────
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.c-cpp-formatter"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.c-cpp-formatter"
  },

  // ── 编辑器行为 ────────────────────────────────────────
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  "editor.renderWhitespace": "selection",
  "editor.rulers": [80, 100, 120],
  "editor.wordWrap": "on",
  "editor.wrappingIndent": "sameIndent",
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",

  // ── 修复 Backspace 误触补全 ───────────────────────────
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.suggestOnTriggerCharacters": true,
  "editor.tabCompletion": "off",

  // ── 视觉 / 动画 ───────────────────────────────────────
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.lineHighlightBackground": "#0D210D",
  "editor.lineHighlightBorder": "#2E7D32",

  // ── 文件管理 ──────────────────────────────────────────
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.next": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.next": true
  },

  // ── 工作区 / UI ───────────────────────────────────────
  "breadcrumbs.enabled": true,
  "explorer.compactFolders": false,
  "window.titleBarStyle": "native",
  "window.zoomLevel": 0,
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "Dark+",

  // ── 绿色主题配色（完善版）────────────────────────────
  "workbench.colorCustomizations": {
    "activityBar.activeForeground": "#C8E6C9",
    "statusBar.noFolderBackground": "#6D4C41",
    "statusBar.noFolderForeground": "#FBF9F8",
    "sideBar.background": "#0D210D",
    "sideBar.foreground": "#C8E6C9",
    "sideBarSectionHeader.background": "#1B5E20",
    "sideBarSectionHeader.foreground": "#C8E6C9",
    "editor.background": "#050D05",
    "editor.foreground": "#C8E6C9",
    "editor.lineHighlightBackground": "#0D210D",
    "editor.lineHighlightBorder": "#2E7D32",
    "editorGutter.background": "#030A03",
    "selection.background": "#2E7D32",
    "scrollbar.shadow": "#00000060",
    "terminal.background": "#050D05",
    "terminal.foreground": "#C8E6C9",
    "terminal.ansiGreen": "#2E7D32",
    "terminal.ansiBrightGreen": "#43A047",
    "badge.background": "#2E7D32",
    "badge.foreground": "#C8E6C9",
    "button.background": "#2E7D32",
    "button.foreground": "#C8E6C9",
    "button.hoverBackground": "#43A047",
    "focusBorder": "#2E7D32",
    "list.activeSelectionBackground": "#1B5E20",
    "list.activeSelectionForeground": "#C8E6C9",
    "list.focusBackground": "#2E7D32",
    "list.focusForeground": "#C8E6C9",
    "list.hoverBackground": "#0D210D",
    "list.hoverForeground": "#C8E6C9",
    "panel.background": "#2C2420",
    "panelTitle.activeForeground": "#FBF9F8",
    "panelTitle.inactiveForeground": "#81C781",
    "tab.activeBackground": "#0D210D",
    "tab.activeForeground": "#C8E6C9",
    "tab.inactiveBackground": "#030A03",
    "tab.inactiveForeground": "#4CAF50"
  },

  // ── Git ───────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // ── 终端 ──────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace",
  "terminal.integrated.defaultProfile.osx": "zsh",

  // ── TypeScript / JavaScript ──────────────────────────
  "typescript.reportSemanticErrors": true,
  "typescript.tsserver.enable": true,
  "javascript.validate.enable": true,

  // ── Go ───────────────────────────────────────────────
  "go.useLanguageServer": true,
  "go.formatTool": "goimports",

  // ── Python ───────────────────────────────────────────
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,

  // ── Rust ─────────────────────────────────────────────
  "rust-analyzer.checkOnSave.command": "clippy",

  // ── C / C++ ──────────────────────────────────────────
  "C_Cpp.default.compilerPath": "/usr/bin/gcc",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "angular.enable-strict-mode-prompt": false
}
