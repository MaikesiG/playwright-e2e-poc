{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "*": ["./*"],
      "@app/*": ["./app/*"],
      "@shared/*": ["./shared/*"]
    },
    "types": ["jasmine", "node"]
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
